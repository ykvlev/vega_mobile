# Local development only. Never use these credentials for production.
DATABASE_URL=postgresql://vega:vega@127.0.0.1:5432/vega_test?schema=public
NODE_ENV=development
APP_MODE=demo
COMMERCE_ENABLED=false
PORT=3001
# Server-only URL used by the read-only catalog lab. Never expose as NEXT_PUBLIC.
CATALOG_API_URL=http://127.0.0.1:3001
# Experimental demo-only auth. Enable only in an isolated demo/test environment.
AUTH_DEMO_ENABLED=false
# Required when auth is enabled: generate at least 32 random bytes, never commit it.
AUTH_RATE_LIMIT_SECRET=
