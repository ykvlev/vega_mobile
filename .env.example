# Local development only. Never use these credentials for production.
DATABASE_URL=postgresql://vega:vega@127.0.0.1:5432/vega_test?schema=public
NODE_ENV=development
APP_MODE=demo
COMMERCE_ENABLED=false
PORT=3001
# Server-only URL used by the read-only catalog lab. Never expose as NEXT_PUBLIC.
CATALOG_API_URL=http://127.0.0.1:3001
# Experimental demo-only auth. Enable only in an isolated demo/test environment.
AUTH_DEMO_ENABLED=false
# Required when auth is enabled: generate at least 32 random bytes, never commit it.
AUTH_RATE_LIMIT_SECRET=

# Server-only auth API origin for the account screen.
AUTH_API_URL=http://127.0.0.1:3001

# Optional demo staff provisioning only. Never commit real credentials.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Canonical public API origin for product media links (never inferred from Host).
PUBLIC_MEDIA_ORIGIN=http://127.0.0.1:3001

# Public, non-secret mobile API origin. For a physical phone use its reachable HTTPS API.
EXPO_PUBLIC_API_URL=
# Optional private-LAN HTTP only in an explicit native development build. Never production.
EXPO_PUBLIC_ALLOW_HTTP_DEMO=false

# Optional public 3D scene origin, separate from API/app; HTTPS for native builds.
# Empty leaves catalog working and displays the 3D fallback.
EXPO_PUBLIC_STUDIO_URL=
