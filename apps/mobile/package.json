{
  "name": "@vega/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web --max-workers 2",
    "test:unit": "node --test test/*.test.mjs",
    "eas-build-post-install": "node ../../scripts/mobile-build-env.mjs && pnpm --filter @vega/contracts build"
  },
  "dependencies": {
    "@expo/log-box": "58.0.13",
    "@expo/metro-runtime": "58.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vega/contracts": "workspace:*",
    "expo": "58.0.17",
    "expo-constants": "58.0.13",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.25",
    "expo-secure-store": "58.0.2",
    "expo-system-ui": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
