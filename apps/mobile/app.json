{
  "expo": {
    "name": "VEGA",
    "slug": "vega-mobile",
    "version": "0.0.0",
    "scheme": "vega-dev",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": true
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "bundleIdentifier": "com.vegappf.mobile.preview",
      "supportsTablet": false
    },
    "android": {
      "package": "com.vegappf.mobile.preview",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
