{
  "name": "@vega/api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "pnpm build && pnpm start",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm build && node --test test/unit.test.mjs",
    "test:integration": "pnpm build && node --test --test-concurrency=1 test/integration.test.mjs test/auth-integration.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "demo:seed": "pnpm build && node dist/demo-seed-cli.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@vega/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
