generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  skuId        String   @unique @default(uuid()) @db.Uuid
  article      String   @unique
  name         String
  description  String?
  categoryId   String   @db.Uuid
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rollLengthMm Int
  widthMm      Int
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([categoryId, id])
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  phone         String        @unique @db.VarChar(12)
  passwordHash  String
  role          String        @default("customer")
  phoneVerified Boolean       @default(false)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  sessions      AuthSession[]
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  scope       String
  keyHash     String   @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  windowEnds  DateTime @db.Timestamptz(3)
  attempts    Int

  @@id([scope, keyHash, windowStart])
  @@index([windowEnds])
}
